{
  "registration_contract_version": "mw_perf.p0a_contract.v5",
  "base_contract_version": "mw_perf.p0a_contract.v4",
  "artifact_schemas": {
    "mw_perf.p0a.hook_callgraph.v2": {
      "type": "object",
      "required": ["schema", "run_id", "capability_id", "path_id", "deployment_mode", "producer", "finalized", "conclusion", "claim", "inputs", "boundary_catalog", "runtime_binding", "boundary_records", "stage_record_count", "callback_record_count", "delivery_set", "temporal_ordering", "complete_set_equality", "zero_status", "zero_loss_and_exclusion_counters"],
      "properties": {
        "schema": {"const": "mw_perf.p0a.hook_callgraph.v2"},
        "run_id": {"type": "string", "minLength": 1},
        "capability_id": {"const": "dds.ordinary.nonplain.single_driver.sync_callback"},
        "path_id": {"type": "string", "minLength": 1},
        "deployment_mode": {"const": "managed"},
        "producer": {"const": "mw_perf_collect"},
        "finalized": {"const": true},
        "conclusion": {"const": "pass"},
        "claim": {"type": "object", "additionalProperties": false, "required": ["kind", "threat_model", "coverage", "dynamic_stack_observation", "runtime_function_addresses_observed", "source_to_build_provenance"], "properties": {"kind": {"const": "semantic_boundary_chain"}, "threat_model": {"const": "cooperative_sut"}, "coverage": {"const": "successful_exact_deliveries_only"}, "dynamic_stack_observation": {"const": "none"}, "runtime_function_addresses_observed": {"const": false}, "source_to_build_provenance": {"const": "not_proven"}}},
        "inputs": {"type": "object", "additionalProperties": false, "required": ["registration_contract_sha256", "resolution", "identity_trace", "boundary_catalog_sha256"], "properties": {"registration_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "resolution": {"type": "object", "additionalProperties": false, "required": ["content_sha256", "declaration_sha256"], "properties": {"content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "identity_trace": {"type": "object", "additionalProperties": false, "required": ["content_sha256", "source_set_sha256", "record_count"], "properties": {"content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "record_count": {"type": "integer", "minimum": 1}}}, "boundary_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "boundary_catalog": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["logical_boundary", "production_function", "source_path", "source_binding"], "properties": {"logical_boundary": {"type": "string", "minLength": 1}, "production_function": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1}, "source_binding": {"const": "trusted_contract_declaration"}}}},
        "runtime_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["producer_pid", "producer_start_time_ticks", "resolved_images"],
          "properties": {
            "producer_pid": {"type": "integer", "minimum": 1},
            "producer_start_time_ticks": {"type": "integer", "minimum": 0},
            "resolved_images": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["role", "name", "source", "expected_path", "sha256", "declaration_sha256", "observation_ids"],
                "properties": {
                  "role": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1},
                  "source": {"enum": ["exe", "maps"]},
                  "expected_path": {"type": "string", "pattern": "^/"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
                }
              }
            }
          }
        },
        "boundary_records": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["logical_boundary", "record_count"], "properties": {"logical_boundary": {"type": "string", "minLength": 1}, "record_count": {"type": "integer", "minimum": 1}}}},
        "stage_record_count": {"type": "integer", "minimum": 3},
        "callback_record_count": {"type": "integer", "minimum": 1},
        "delivery_set": {"type": "object", "additionalProperties": false, "required": ["key_fields", "sha256", "count"], "properties": {"key_fields": {"const": ["writer_guid", "sequence_high", "sequence_low", "reader_guid", "callback_registration_id"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 1}}},
        "temporal_ordering": {"type": "object", "additionalProperties": false, "required": ["clock_domain", "constraints"], "properties": {"clock_domain": {"const": "producer_monotonic"}, "constraints": {"const": ["publish_start_ns<=receive_start_ns", "receive_end_ns<=dispatch_start_ns", "dispatch_start_ns<=callback_start_ns", "callback_start_ns<=callback_end_ns", "callback_end_ns<=dispatch_end_ns"]}}},
        "complete_set_equality": {"const": true},
        "zero_status": {"const": true},
        "zero_loss_and_exclusion_counters": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "artifact_overrides": [
    {"universe": "proof", "relative_path": "capability/hook_callgraph.json", "schema_version": "mw_perf.p0a.hook_callgraph.v2", "format": "json", "record_count_rule": "document", "min_record_count": 1, "finalization": "complete"}
  ]
}
