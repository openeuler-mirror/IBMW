{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.p0a.ohos_remote_fault_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "case_id", "campaign_id", "subject_run_id", "request_challenge", "capture_nonce", "subject_status", "semantic_validation", "sut_exit_zero", "directory_finalization_present", "observed_failure_kind", "observed_error", "observed_failure_codes", "injected_observation", "fault_build_identity_sha256", "production_anchor", "runtime_image_hashes", "contract", "request_sha256", "result_sha256", "archive_sha256", "archive_tree_sha256", "registration_sha256", "approval_sha256"],
  "properties": {
    "schema": {"const": "mw_perf.p0a.ohos_remote_fault_receipt.v1"},
    "case_id": {"enum": ["callback_loss", "callback_status", "producer_identity_mismatch", "stage_loss", "stage_status"]},
    "campaign_id": {"$ref": "#/$defs/id"},
    "subject_run_id": {"$ref": "#/$defs/id"},
    "request_challenge": {"$ref": "#/$defs/hash"},
    "capture_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "subject_status": {"const": "invalid"},
    "semantic_validation": {"const": false},
    "sut_exit_zero": {"const": true},
    "directory_finalization_present": {"const": false},
    "observed_failure_kind": {"enum": ["stage_zero_loss", "callback_zero_loss", "producer_identity", "stage_nonzero_status", "callback_nonzero_status"]},
    "observed_error": {"const": "imported trace semantic validation failed"},
    "observed_failure_codes": {"const": ["P0A_ARTIFACT", "P0A_DDS_COMM_TRACE"]},
    "injected_observation": {"$ref": "#/$defs/observation"},
    "fault_build_identity_sha256": {"$ref": "#/$defs/nonzeroHash"},
    "production_anchor": {"$ref": "#/$defs/anchor"},
    "runtime_image_hashes": {"$ref": "#/$defs/images"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"const": "mw_perf.p0a_contract.v8"}, "sha256": {"$ref": "#/$defs/nonzeroHash"}}},
    "request_sha256": {"$ref": "#/$defs/nonzeroHash"},
    "result_sha256": {"$ref": "#/$defs/nonzeroHash"},
    "archive_sha256": {"$ref": "#/$defs/nonzeroHash"},
    "archive_tree_sha256": {"$ref": "#/$defs/nonzeroHash"},
    "registration_sha256": {"$ref": "#/$defs/nonzeroHash"},
    "approval_sha256": {"$ref": "#/$defs/nonzeroHash"}
  },
  "allOf": [
    {"if": {"properties": {"case_id": {"const": "stage_loss"}}}, "then": {"properties": {"observed_failure_kind": {"const": "stage_zero_loss"}}}},
    {"if": {"properties": {"case_id": {"const": "callback_loss"}}}, "then": {"properties": {"observed_failure_kind": {"const": "callback_zero_loss"}}}},
    {"if": {"properties": {"case_id": {"const": "producer_identity_mismatch"}}}, "then": {"properties": {"observed_failure_kind": {"const": "producer_identity"}}}},
    {"if": {"properties": {"case_id": {"const": "stage_status"}}}, "then": {"properties": {"observed_failure_kind": {"const": "stage_nonzero_status"}}}},
    {"if": {"properties": {"case_id": {"const": "callback_status"}}}, "then": {"properties": {"observed_failure_kind": {"const": "callback_nonzero_status"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzeroHash": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["registration_id", "sha256", "build_identity_sha256"], "properties": {"registration_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/nonzeroHash"}, "build_identity_sha256": {"$ref": "#/$defs/nonzeroHash"}}},
    "images": {"type": "object", "additionalProperties": false, "required": ["sut", "extension", "fastdds", "fastcdr", "cpp_runtime"], "properties": {"sut": {"$ref": "#/$defs/nonzeroHash"}, "extension": {"$ref": "#/$defs/nonzeroHash"}, "fastdds": {"$ref": "#/$defs/nonzeroHash"}, "fastcdr": {"$ref": "#/$defs/nonzeroHash"}, "cpp_runtime": {"$ref": "#/$defs/nonzeroHash"}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["stage_dropped_before", "stage_dropped_after", "stage_invalid_identity", "stage_unsupported_async", "exact_dropped", "exact_invalid_identity", "exact_missing_registration", "exact_unsupported_async", "exact_unsupported_multi_handler", "stage_nonzero_status_count", "exact_nonzero_status_count", "producer_run_id_matches_subject"], "properties": {"stage_dropped_before": {"type": "integer", "minimum": 0}, "stage_dropped_after": {"type": "integer", "minimum": 0}, "stage_invalid_identity": {"type": "integer", "minimum": 0}, "stage_unsupported_async": {"type": "integer", "minimum": 0}, "exact_dropped": {"type": "integer", "minimum": 0}, "exact_invalid_identity": {"type": "integer", "minimum": 0}, "exact_missing_registration": {"type": "integer", "minimum": 0}, "exact_unsupported_async": {"type": "integer", "minimum": 0}, "exact_unsupported_multi_handler": {"type": "integer", "minimum": 0}, "stage_nonzero_status_count": {"type": "integer", "minimum": 0}, "exact_nonzero_status_count": {"type": "integer", "minimum": 0}, "producer_run_id_matches_subject": {"type": "boolean"}}}
  }
}
