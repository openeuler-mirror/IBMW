{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.ohos_p0a_registration.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registration_role", "registration_id", "capability_id", "campaign_id", "device", "exact_boot_id", "toolchain", "source", "capture_agent", "runtime_images", "build_identity", "threat_model", "approval_artifact", "trust_classification"],
  "properties": {
    "schema": {"const": "mw_perf.ohos_p0a_registration.v1"},
    "registration_role": {"enum": ["production_anchor", "fault_runtime_subject"]},
    "registration_id": {"$ref": "#/$defs/id"},
    "capability_id": {"const": "dds.ordinary.nonplain.single_driver.sync_callback"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "device": {"type": "object", "additionalProperties": false, "required": ["serial", "os_name", "os_version", "build_id", "abi", "os_image_sha256"], "properties": {"serial": {"$ref": "#/$defs/id"}, "os_name": {"type": "string", "minLength": 1, "maxLength": 128}, "os_version": {"type": "string", "minLength": 1, "maxLength": 128}, "build_id": {"type": "string", "minLength": 1, "maxLength": 256}, "abi": {"type": "string", "enum": ["arm64-v8a", "armeabi-v7a", "x86_64"]}, "os_image_sha256": {"$ref": "#/$defs/hash"}}},
    "exact_boot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "toolchain": {"type": "object", "additionalProperties": false, "required": ["ohos_sdk_id", "ohos_sdk_sha256", "compiler_id", "compiler_sha256"], "properties": {"ohos_sdk_id": {"type": "string", "minLength": 1, "maxLength": 256}, "ohos_sdk_sha256": {"$ref": "#/$defs/hash"}, "compiler_id": {"type": "string", "minLength": 1, "maxLength": 256}, "compiler_sha256": {"$ref": "#/$defs/hash"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree_sha256"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}, "tree_sha256": {"$ref": "#/$defs/hash"}}},
    "capture_agent": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "runtime_images": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/sut"}, {"$ref": "#/$defs/extension"}, {"$ref": "#/$defs/fastdds"}, {"$ref": "#/$defs/fastcdr"}, {"$ref": "#/$defs/cpp"}], "items": false},
    "build_identity": {"type": "object", "additionalProperties": false, "required": ["formula", "sha256"], "properties": {"formula": {"const": "sha256(canonical_json(source,toolchain,capture_agent,runtime_images))"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "threat_model": {"const": "cooperative_contained_sut_no_active_same_uid"},
    "approval_artifact": {"type": "object", "additionalProperties": false, "required": ["schema", "sha256"], "properties": {"schema": {"const": "mw_perf.ohos_p0a_operator_approval.v1"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "trust_classification": {"$ref": "#/$defs/trustClassification"},
    "production_anchor": {"type": "object", "additionalProperties": false, "required": ["registration_id", "sha256", "build_identity_sha256"], "properties": {"registration_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hash"}, "build_identity_sha256": {"$ref": "#/$defs/hash"}}}
  },
  "allOf": [
    {"if": {"properties": {"registration_role": {"const": "fault_runtime_subject"}}}, "then": {"required": ["production_anchor"]}},
    {"if": {"properties": {"registration_role": {"const": "production_anchor"}}}, "then": {"not": {"required": ["production_anchor"]}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/(?!.*(?:^|/)\\.\\.?/)[ -~]+$"},
    "imageBase": {"type": "object", "additionalProperties": false, "required": ["role", "name", "source", "path", "sha256"], "properties": {"role": {}, "name": {"$ref": "#/$defs/id"}, "source": {}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/nonzeroHash"}}},
    "nonzeroHash": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "sut": {"allOf": [{"$ref": "#/$defs/imageBase"}, {"properties": {"role": {"const": "sut"}, "source": {"const": "exe"}}}]},
    "extension": {"allOf": [{"$ref": "#/$defs/imageBase"}, {"properties": {"role": {"const": "extension"}, "source": {"const": "maps"}}}]},
    "fastdds": {"allOf": [{"$ref": "#/$defs/imageBase"}, {"properties": {"role": {"const": "fastdds"}, "source": {"const": "maps"}}}]},
    "fastcdr": {"allOf": [{"$ref": "#/$defs/imageBase"}, {"properties": {"role": {"const": "fastcdr"}, "source": {"const": "maps"}}}]},
    "cpp": {"allOf": [{"$ref": "#/$defs/imageBase"}, {"properties": {"role": {"const": "cpp_runtime"}, "source": {"const": "maps"}}}]},
    "trustClassification": {"type": "object", "additionalProperties": false, "required": ["preregistered_declarations", "runtime_attested_facts", "self_contained_authority", "external_authority"], "properties": {"preregistered_declarations": {"const": ["device.serial", "device.os_name", "device.os_version", "device.build_id", "device.abi", "device.os_image_sha256", "toolchain", "source", "approval_artifact"]}, "runtime_attested_facts": {"const": ["boot_id", "agent_executable_sha256", "five_live_image_identities"]}, "self_contained_authority": {"const": "retained_consistency_only"}, "external_authority": {"const": "requires_separately_supplied_expected_roots"}}}
  }
}
