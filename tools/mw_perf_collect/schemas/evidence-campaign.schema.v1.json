{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.evidence_campaign.v1",
  "type": "object",
  "required": ["schema", "campaign_id", "classification", "threat_model", "registrations", "limitations"],
  "properties": {
    "schema": {"const": "mw_perf.evidence_campaign.v1"},
    "campaign_id": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$"},
    "classification": {"$ref": "#/$defs/classification"},
    "threat_model": {"const": "cooperative_contained_sut_no_active_same_uid"},
    "registrations": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/registration"}
    },
    "limitations": {
      "const": [
        "This campaign is candidate evidence only and provides no performance acceptance.",
        "This campaign is not formal P0a acceptance."
      ]
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "required": ["classification", "failure_code", "metric_availability", "valid_for_comparison"],
      "properties": {
        "classification": {"const": "candidate"}, "failure_code": {"const": "P0A_ARTIFACT"},
        "metric_availability": {"const": "unsupported"}, "valid_for_comparison": {"const": false}
      }, "additionalProperties": false
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor": {
      "type": "object",
      "required": ["campaign_id", "role", "companion_id", "object_sha256", "bundle_manifest_sha256", "archive_tree_sha256", "run_id", "evidence_contract", "root_manifest_sha256", "evidence_manifest_sha256", "build_identity_sha256"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1}, "role": {"enum": ["exact_anchor", "fault_evidence_tamper", "fault_runtime_matrix", "rollback_trace_off"]},
        "companion_id": {"type": "string", "minLength": 1}, "object_sha256": {"$ref": "#/$defs/hash"}, "bundle_manifest_sha256": {"$ref": "#/$defs/hash"},
        "archive_tree_sha256": {"$ref": "#/$defs/hash"}, "run_id": {"type": "string", "minLength": 1},
        "evidence_contract": {"type": "object", "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}, "additionalProperties": false},
        "root_manifest_sha256": {"$ref": "#/$defs/hash"}, "evidence_manifest_sha256": {"$ref": "#/$defs/hash"}, "build_identity_sha256": {"$ref": "#/$defs/hash"}
      }, "additionalProperties": false
    },
    "registration": {"type": "object", "required": ["role", "descriptor"], "properties": {"role": {"enum": ["exact_anchor", "fault_evidence_tamper", "fault_runtime_matrix", "rollback_trace_off"]}, "descriptor": {"$ref": "#/$defs/descriptor"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
