{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibmw.example/schemas/mw-perf-collect/comparison-plan.schema.v1.json",
  "title": "mw-perf formal A/B/C comparison plan v1",
  "type": "object",
  "required": ["schema", "schema_version", "contract", "profile", "workload", "resource_scope", "order", "blocks"],
  "properties": {
    "schema": {"const": "mw_perf.comparison-plan.v1"},
    "schema_version": {"const": 1},
    "validation_profile": {"enum": ["standard", "p0a"]},
    "order_policy": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "order_seed": {"type": "integer", "minimum": 0},
    "contract": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "profile": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "workload": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "resource_scope": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "minProperties": 1}]},
    "order": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["A", "B", "C"]}, "uniqueItems": true},
    "blocks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["block_id", "runs"],
        "properties": {
          "block_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer"}]},
          "runs": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "object", "required": ["lane", "path"],
              "properties": {"lane": {"enum": ["A", "B", "C"]}, "path": {"type": "string", "minLength": 1}}}
          }
        }
      }
    }
  }
}
