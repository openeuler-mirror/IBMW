{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.rollback_trace_off.v2",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"type": "object", "required": ["classification", "metric_availability", "valid_for_comparison", "failure_code"], "additionalProperties": false, "properties": {"classification": {"const": "candidate"}, "metric_availability": {"const": "unsupported"}, "valid_for_comparison": {"const": false}, "failure_code": {"const": "P0A_ARTIFACT"}}},
    "contract": {"type": "object", "required": ["id", "sha256"], "additionalProperties": false, "properties": {"id": {"const": "mw_perf.p0a_contract.v8"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "image": {"type": "object", "required": ["sha256", "build_id"], "additionalProperties": false, "properties": {"sha256": {"$ref": "#/$defs/hash"}, "build_id": {"type": "string", "minLength": 1}}},
    "symbols": {"type": "object", "required": ["nm_all", "nm_dynamic"], "additionalProperties": false, "properties": {"nm_all": {"type": "integer", "minimum": 1}, "nm_dynamic": {"type": "integer", "minimum": 1}}},
    "provider": {"type": "object", "required": ["sha256", "size", "version", "build_id"], "additionalProperties": false, "properties": {"sha256": {"$ref": "#/$defs/hash"}, "size": {"type": "integer", "minimum": 1}, "version": {"type": ["string", "null"]}, "build_id": {"type": "string", "minLength": 1}}},
    "inventorySubset": {"type": "object", "required": ["record_count", "content_sha256"], "additionalProperties": false, "properties": {"record_count": {"type": "integer", "minimum": 0}, "content_sha256": {"$ref": "#/$defs/hash"}}},
    "linkTarget": {"type": "object", "required": ["image", "closure_sha256", "output_sha256", "input_count", "response_count"], "additionalProperties": false, "properties": {"image": {"enum": ["extension", "executable"]}, "closure_sha256": {"$ref": "#/$defs/hash"}, "output_sha256": {"$ref": "#/$defs/hash"}, "input_count": {"type": "integer", "minimum": 1}, "response_count": {"type": "integer", "minimum": 0}}},
    "linkSummary": {"type": "object", "required": ["content_sha256", "targets"], "additionalProperties": false, "properties": {"content_sha256": {"$ref": "#/$defs/hash"}, "targets": {"type": "object", "required": ["ibmw_dds_extension", "ibmw_dds_trace_off_business_roundtrip"], "additionalProperties": false, "properties": {"ibmw_dds_extension": {"$ref": "#/$defs/linkTarget"}, "ibmw_dds_trace_off_business_roundtrip": {"$ref": "#/$defs/linkTarget"}}}}},
    "dependency": {"type": "object", "required": ["name", "override_variable", "cache_bindings", "file_count", "directory_count", "byte_count", "tree_sha256"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "override_variable": {"type": "string", "pattern": "^FETCHCONTENT_SOURCE_DIR_[A-Z0-9_.+-]+$"}, "cache_bindings": {"type": "array", "items": {"type": "object", "required": ["variable", "relative"], "additionalProperties": false, "properties": {"variable": {"type": "string", "minLength": 1, "pattern": "_(SOURCE_DIR|LOCAL_SOURCE)$"}, "relative": {"type": "string", "minLength": 1, "pattern": "^(?:\\.|(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9_+.-]+(?:/[A-Za-z0-9_+.-]+)*)$"}}}}, "file_count": {"type": "integer", "minimum": 1, "maximum": 500000}, "directory_count": {"type": "integer", "minimum": 0, "maximum": 500000}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 17179869184}, "tree_sha256": {"$ref": "#/$defs/hash"}}}
  },
  "type": "object",
  "required": ["schema", "classification", "claim", "limitations", "anchor", "source", "product_delta", "evidence_control", "dependency_source_control", "compile_out", "link_closure", "image_summaries", "symbol_summary", "provider_summary", "runtime_summary", "rollback_build_identity_sha256"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "mw_perf.rollback_trace_off.v2"},
    "classification": {"$ref": "#/$defs/classification"},
    "claim": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "anchor": {"type": "object", "required": ["run_id", "root_manifest_sha256", "evidence_manifest_sha256", "registration_contract", "production_build_identity_sha256"], "additionalProperties": false, "properties": {"run_id": {"type": "string", "minLength": 1}, "root_manifest_sha256": {"$ref": "#/$defs/hash"}, "evidence_manifest_sha256": {"$ref": "#/$defs/hash"}, "registration_contract": {"$ref": "#/$defs/contract"}, "production_build_identity_sha256": {"$ref": "#/$defs/hash"}}},
    "source": {"type": "object", "required": ["commit", "dirty", "diff_sha256", "untracked_tree_sha256", "untracked_count", "working_tree_sha256"], "additionalProperties": false, "properties": {"commit": {"type": "string", "minLength": 1}, "branch": {"type": "string"}, "dirty": {"type": "boolean"}, "diff_sha256": {"$ref": "#/$defs/hash"}, "untracked_tree_sha256": {"$ref": "#/$defs/hash"}, "untracked_count": {"type": "integer", "minimum": 0}, "working_tree_sha256": {"$ref": "#/$defs/hash"}}},
    "product_delta": {"type": "object", "required": ["IBMW_ENABLE_COMM_TRACE"], "additionalProperties": false, "properties": {"IBMW_ENABLE_COMM_TRACE": {"type": "object", "required": ["anchor", "fresh"], "additionalProperties": false, "properties": {"anchor": {"const": "ON"}, "fresh": {"const": "OFF"}}}, "IBMW_BUILD_DDS_MANAGED_EXACT_CANDIDATE": {"type": "object", "required": ["anchor", "fresh"], "additionalProperties": false, "properties": {"anchor": {"const": "ON"}, "fresh": {"const": "OFF"}}}}},
    "evidence_control": {"type": "object", "required": ["name", "forced", "fresh"], "additionalProperties": false, "properties": {"name": {"const": "CMAKE_EXPORT_COMPILE_COMMANDS"}, "forced": {"const": "ON"}, "fresh": {"const": "ON"}}},
    "dependency_source_control": {"type": "object", "required": ["provider", "reuse_scope", "cache_verified", "dependency_count", "file_count", "directory_count", "byte_count", "aggregate_sha256", "mutation_checkpoints", "checkpoint_digests", "dependencies"], "additionalProperties": false, "properties": {"provider": {"const": "anchor_fetchcontent_source_cache"}, "reuse_scope": {"const": "source_only"}, "cache_verified": {"const": true}, "dependency_count": {"type": "integer", "minimum": 1, "maximum": 128}, "file_count": {"type": "integer", "minimum": 1, "maximum": 500000}, "directory_count": {"type": "integer", "minimum": 0, "maximum": 500000}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 17179869184}, "aggregate_sha256": {"$ref": "#/$defs/hash"}, "mutation_checkpoints": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["anchor_before_staging", "staged_after_copy", "anchor_after_staging", "staged_after_configure", "anchor_after_configure", "staged_after_build", "anchor_after_build"]}}, "checkpoint_digests": {"type": "object", "required": ["anchor_before_staging", "staged_after_copy", "anchor_after_staging", "staged_after_configure", "anchor_after_configure", "staged_after_build", "anchor_after_build"], "additionalProperties": false, "properties": {"anchor_before_staging": {"$ref": "#/$defs/hash"}, "staged_after_copy": {"$ref": "#/$defs/hash"}, "anchor_after_staging": {"$ref": "#/$defs/hash"}, "anchor_after_configure": {"$ref": "#/$defs/hash"}, "staged_after_configure": {"$ref": "#/$defs/hash"}, "staged_after_build": {"$ref": "#/$defs/hash"}, "anchor_after_build": {"$ref": "#/$defs/hash"}}}, "dependencies": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/dependency"}}}},
    "compile_out": {"type": "object", "required": ["record_count", "content_sha256", "registered_records", "other_records", "claim"], "additionalProperties": false, "properties": {"record_count": {"type": "integer", "minimum": 2}, "content_sha256": {"$ref": "#/$defs/hash"}, "registered_records": {"$ref": "#/$defs/inventorySubset"}, "other_records": {"$ref": "#/$defs/inventorySubset"}, "claim": {"type": "string", "minLength": 1}}},
    "link_closure": {"$ref": "#/$defs/linkSummary"},
    "image_summaries": {"type": "object", "required": ["extension", "executable"], "additionalProperties": false, "properties": {"extension": {"$ref": "#/$defs/image"}, "executable": {"$ref": "#/$defs/image"}}},
    "symbol_summary": {"type": "object", "required": ["extension", "executable"], "additionalProperties": false, "properties": {"extension": {"$ref": "#/$defs/symbols"}, "executable": {"$ref": "#/$defs/symbols"}}},
    "provider_summary": {"type": "object", "required": ["dds", "cdr"], "additionalProperties": false, "properties": {"dds": {"$ref": "#/$defs/provider"}, "cdr": {"$ref": "#/$defs/provider"}}},
    "runtime_summary": {"type": "object", "required": ["returncode", "observations_sha256", "observations_count", "executable_matches", "extension_matches", "provider_matches", "executable_sha256", "extension_sha256", "dds_provider_sha256", "cdr_provider_sha256", "stdout_sha256", "stderr_sha256"], "additionalProperties": false, "properties": {"returncode": {"const": 0}, "observations_sha256": {"$ref": "#/$defs/hash"}, "observations_count": {"type": "integer", "minimum": 1}, "executable_matches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}}, "extension_matches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}}, "provider_matches": {"type": "object", "required": ["dds", "cdr"], "additionalProperties": false, "properties": {"dds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}}, "cdr": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}}}}, "executable_sha256": {"$ref": "#/$defs/hash"}, "extension_sha256": {"$ref": "#/$defs/hash"}, "dds_provider_sha256": {"$ref": "#/$defs/hash"}, "cdr_provider_sha256": {"$ref": "#/$defs/hash"}, "stdout_sha256": {"$ref": "#/$defs/hash"}, "stderr_sha256": {"$ref": "#/$defs/hash"}}},
    "rollback_build_identity_sha256": {"$ref": "#/$defs/hash"}
  }
