{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.p0a.remote_resolution.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "capability_id", "path_id", "deployment_mode", "producer", "finalized", "declaration_sha256", "declarations", "ready_observations", "completion_observations", "matches", "resolved", "conclusion"],
  "properties": {
    "schema": {"const": "mw_perf.p0a.remote_resolution.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "capability_id": {"const": "dds.ordinary.nonplain.single_driver.sync_callback"},
    "path_id": {"type": "string", "minLength": 1},
    "deployment_mode": {"const": "managed"},
    "producer": {"const": "ohos_remote_capture_v2"},
    "finalized": {"const": true},
    "declaration_sha256": {"$ref": "#/$defs/hash"},
    "declarations": {"$ref": "#/$defs/declarations"},
    "ready_observations": {"$ref": "#/$defs/observations"},
    "completion_observations": {"$ref": "#/$defs/observations"},
    "matches": {"$ref": "#/$defs/matches"},
    "resolved": {"const": true},
    "conclusion": {"const": "pass"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["role", "name", "source", "path", "sha256"], "properties": {"role": {"enum": ["sut", "extension", "fastdds", "fastcdr", "cpp_runtime"]}, "name": {"type": "string", "minLength": 1}, "source": {"enum": ["exe", "maps"]}, "path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "sut": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "sut"}, "source": {"const": "exe"}}}]},
    "extension": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "extension"}, "source": {"const": "maps"}}}]},
    "fastdds": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "fastdds"}, "source": {"const": "maps"}}}]},
    "fastcdr": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "fastcdr"}, "source": {"const": "maps"}}}]},
    "cpp": {"allOf": [{"$ref": "#/$defs/identity"}, {"properties": {"role": {"const": "cpp_runtime"}, "source": {"const": "maps"}}}]},
    "observationBase": {"type": "object", "additionalProperties": false, "required": ["observation_id", "phase", "role", "name", "source", "path", "sha256", "device_major", "device_minor", "inode"], "properties": {"observation_id": {"$ref": "#/$defs/hash"}, "phase": {"enum": ["ready", "completion"]}, "role": {"enum": ["sut", "extension", "fastdds", "fastcdr", "cpp_runtime"]}, "name": {"type": "string", "minLength": 1}, "source": {"enum": ["exe", "maps"]}, "path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "device_major": {"type": "integer", "minimum": 0}, "device_minor": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}}},
    "matchBase": {"type": "object", "additionalProperties": false, "required": ["role", "name", "source", "path", "sha256", "ready_observation", "completion_observation"], "properties": {"role": {"enum": ["sut", "extension", "fastdds", "fastcdr", "cpp_runtime"]}, "name": {"type": "string", "minLength": 1}, "source": {"enum": ["exe", "maps"]}, "path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}, "ready_observation": {"$ref": "#/$defs/hash"}, "completion_observation": {"$ref": "#/$defs/hash"}}},
    "observationSut": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"role": {"const": "sut"}, "source": {"const": "exe"}}}]},
    "observationExtension": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"role": {"const": "extension"}, "source": {"const": "maps"}}}]},
    "observationFastdds": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"role": {"const": "fastdds"}, "source": {"const": "maps"}}}]},
    "observationFastcdr": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"role": {"const": "fastcdr"}, "source": {"const": "maps"}}}]},
    "observationCpp": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"role": {"const": "cpp_runtime"}, "source": {"const": "maps"}}}]},
    "matchSut": {"allOf": [{"$ref": "#/$defs/matchBase"}, {"properties": {"role": {"const": "sut"}, "source": {"const": "exe"}}}]},
    "matchExtension": {"allOf": [{"$ref": "#/$defs/matchBase"}, {"properties": {"role": {"const": "extension"}, "source": {"const": "maps"}}}]},
    "matchFastdds": {"allOf": [{"$ref": "#/$defs/matchBase"}, {"properties": {"role": {"const": "fastdds"}, "source": {"const": "maps"}}}]},
    "matchFastcdr": {"allOf": [{"$ref": "#/$defs/matchBase"}, {"properties": {"role": {"const": "fastcdr"}, "source": {"const": "maps"}}}]},
    "matchCpp": {"allOf": [{"$ref": "#/$defs/matchBase"}, {"properties": {"role": {"const": "cpp_runtime"}, "source": {"const": "maps"}}}]},
    "declarations": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/sut"}, {"$ref": "#/$defs/extension"}, {"$ref": "#/$defs/fastdds"}, {"$ref": "#/$defs/fastcdr"}, {"$ref": "#/$defs/cpp"}], "items": false},
    "observations": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/observationSut"}, {"$ref": "#/$defs/observationExtension"}, {"$ref": "#/$defs/observationFastdds"}, {"$ref": "#/$defs/observationFastcdr"}, {"$ref": "#/$defs/observationCpp"}], "items": false},
    "matches": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [{"$ref": "#/$defs/matchSut"}, {"$ref": "#/$defs/matchExtension"}, {"$ref": "#/$defs/matchFastdds"}, {"$ref": "#/$defs/matchFastcdr"}, {"$ref": "#/$defs/matchCpp"}], "items": false}
  }
}
