{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.p0a.fault_evidence_tamper.v1",
  "type": "object",
  "required": ["schema", "campaign_classification", "threat_model", "finalized", "conclusion", "subject_status", "anchor", "mutation", "validation", "archive_tree_after_sha256"],
  "properties": {
    "schema": {"const": "mw_perf.p0a.fault_evidence_tamper.v1"},
    "campaign_classification": {
      "type": "object",
      "required": ["classification", "metric_availability", "valid_for_comparison", "failure_code"],
      "properties": {
        "classification": {"const": "candidate"},
        "metric_availability": {"const": "unsupported"},
        "valid_for_comparison": {"const": false},
        "failure_code": {"const": "P0A_ARTIFACT"}
      },
      "additionalProperties": false
    },
    "threat_model": {"const": "archived_evidence_single_byte_xor"},
    "finalized": {"const": true},
    "conclusion": {"const": "pass"},
    "subject_status": {"const": "invalid"},
    "anchor": {
      "type": "object",
      "required": ["run_id", "root_manifest_sha256", "evidence_manifest_sha256", "registration_contract", "archive_tree_before_sha256"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "root_manifest_sha256": {"$ref": "#/$defs/hash"},
        "evidence_manifest_sha256": {"$ref": "#/$defs/hash"},
        "registration_contract": {
          "type": "object",
          "required": ["id", "sha256"],
          "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}},
          "additionalProperties": false
        },
        "archive_tree_before_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "required": ["target_relative", "offset", "size", "before_sha256", "after_sha256", "xor_mask"],
      "properties": {
        "target_relative": {"enum": ["capability/hook_callgraph.json", "capability/communication_latency.json", "validation/communication_delivery.json", "normalized/identity_trace.jsonl"]},
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 1},
        "before_sha256": {"$ref": "#/$defs/hash"},
        "after_sha256": {"$ref": "#/$defs/hash"},
        "xor_mask": {"const": 1}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["baseline_top_codes", "baseline_p0a_codes", "observed_top_codes", "observed_p0a_codes", "expected_new_p0a_code"],
      "properties": {
        "baseline_top_codes": {"$ref": "#/$defs/codes"},
        "baseline_p0a_codes": {"$ref": "#/$defs/codes"},
        "observed_top_codes": {"$ref": "#/$defs/codes"},
        "observed_p0a_codes": {"$ref": "#/$defs/codes"},
        "expected_new_p0a_code": {"enum": ["P0A_HOOK_CALLGRAPH", "P0A_COMMUNICATION_LATENCY", "P0A_COMMUNICATION_DELIVERY", "P0A_IDENTITY_TRACE"]}
      },
      "additionalProperties": false
    },
    "archive_tree_after_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_:.$\\[\\]-]+$"}}
  },
  "additionalProperties": false
}
