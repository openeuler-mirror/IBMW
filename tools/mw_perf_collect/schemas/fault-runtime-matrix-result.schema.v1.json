{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.p0a.fault_runtime_matrix.v1",
  "type": "object",
  "required": ["schema", "campaign_classification", "threat_model", "evidence_claim", "instrumentation_relationship", "production_build_identity_sha256", "fault_build_identity_sha256", "finalized", "conclusion", "matrix_id", "cases", "subjects_archive_tree_sha256", "anchor"],
  "properties": {
    "schema": {"const": "mw_perf.p0a.fault_runtime_matrix.v1"},
    "campaign_classification": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "metric_availability", "valid_for_comparison", "failure_code"],
      "properties": {
        "classification": {"const": "candidate"},
        "metric_availability": {"const": "unsupported"},
        "valid_for_comparison": {"const": false},
        "failure_code": {"const": "P0A_ARTIFACT"}
      }
    },
    "threat_model": {"const": "managed_runtime_fault_injection_matrix"},
    "evidence_claim": {"const": "collector_fail_closed_on_deterministic_test_instrumented_producer_anomalies"},
    "instrumentation_relationship": {"const": "test_instrumented_fault_producer_not_binary_identical_to_anchor"},
    "production_build_identity_sha256": {"$ref": "#/$defs/hash"},
    "fault_build_identity_sha256": {"$ref": "#/$defs/hash"},
    "finalized": {"const": true},
    "conclusion": {"const": "pass"},
    "matrix_id": {"type": "string", "pattern": "^runtime-fault-matrix-[0-9a-f]{24}$"},
    "cases": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "#/$defs/case"}
    },
    "subjects_archive_tree_sha256": {"$ref": "#/$defs/hash"},
    "anchor": {"$ref": "#/$defs/anchor"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"const": "mw_perf.p0a_contract.v8"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["run_id", "root_manifest_sha256", "evidence_manifest_sha256", "contract", "archive_tree_sha256"], "properties": {"run_id": {"type": "string", "minLength": 1}, "root_manifest_sha256": {"$ref": "#/$defs/hash"}, "evidence_manifest_sha256": {"$ref": "#/$defs/hash"}, "contract": {"$ref": "#/$defs/contract"}, "archive_tree_sha256": {"$ref": "#/$defs/hash"}}},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_dropped_before", "stage_dropped_after", "stage_invalid_identity", "stage_unsupported_async", "exact_dropped", "exact_invalid_identity", "exact_missing_registration", "exact_unsupported_async", "exact_unsupported_multi_handler", "stage_nonzero_status_count", "exact_nonzero_status_count", "producer_run_id_matches_subject"],
      "properties": {
        "stage_dropped_before": {"type": "integer", "minimum": 0}, "stage_dropped_after": {"type": "integer", "minimum": 0},
        "stage_invalid_identity": {"type": "integer", "minimum": 0}, "stage_unsupported_async": {"type": "integer", "minimum": 0},
        "exact_dropped": {"type": "integer", "minimum": 0}, "exact_invalid_identity": {"type": "integer", "minimum": 0},
        "exact_missing_registration": {"type": "integer", "minimum": 0}, "exact_unsupported_async": {"type": "integer", "minimum": 0},
        "exact_unsupported_multi_handler": {"type": "integer", "minimum": 0},
        "stage_nonzero_status_count": {"type": "integer", "minimum": 0}, "exact_nonzero_status_count": {"type": "integer", "minimum": 0},
        "producer_run_id_matches_subject": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "subject_run_id", "root_manifest_sha256", "evidence_manifest_sha256", "contract", "subject_status", "sut_exit_zero", "directory_finalization_present", "injected_observation", "observed_failure_kind", "observed_error", "observed_failure_codes", "production_build_identity_sha256", "fault_build_identity_sha256", "runtime_image_hashes"],
      "properties": {
        "case_id": {"enum": ["callback_loss", "callback_status", "producer_identity_mismatch", "stage_loss", "stage_status"]}, "subject_run_id": {"type": "string", "minLength": 1},
        "root_manifest_sha256": {"$ref": "#/$defs/hash"}, "evidence_manifest_sha256": {"$ref": "#/$defs/hash"},
        "contract": {"$ref": "#/$defs/contract"}, "subject_status": {"const": "invalid"},
        "sut_exit_zero": {"const": true}, "directory_finalization_present": {"const": false},
        "injected_observation": {"$ref": "#/$defs/observation"},
        "observed_failure_kind": {"enum": ["stage_zero_loss", "callback_zero_loss", "producer_identity", "stage_nonzero_status", "callback_nonzero_status"]},
        "observed_error": {"enum": ["DDS trace required zero-loss finalization failed", "exact seal is not finalized", "DDS trace identity mismatch: run_id", "exact correlation requires zero status for every event"]},
        "observed_failure_codes": {"type": "array", "uniqueItems": true, "allOf": [{"contains": {"const": "P0A_ARTIFACT"}}, {"contains": {"const": "P0A_DDS_COMM_TRACE"}}], "items": {"type": "string", "pattern": "^[A-Z0-9_:.$\\[\\]-]+$"}},
        "production_build_identity_sha256": {"$ref": "#/$defs/hash"},
        "fault_build_identity_sha256": {"$ref": "#/$defs/hash"},
        "runtime_image_hashes": {"type": "object", "additionalProperties": false, "required": ["sut", "extension"], "properties": {"sut": {"$ref": "#/$defs/hash"}, "extension": {"$ref": "#/$defs/hash"}}}
      }
    }
  },
  "additionalProperties": false
}
