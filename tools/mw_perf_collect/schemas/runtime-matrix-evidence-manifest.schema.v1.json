{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mw_perf.p0a.runtime_matrix_evidence_manifest.v1",
  "type": "object",
  "required": ["schema", "matrix_id", "subjects"],
  "properties": {
    "schema": {"const": "mw_perf.p0a.runtime_matrix_evidence_manifest.v1"},
    "matrix_id": {"type": "string", "pattern": "^runtime-fault-matrix-[0-9a-f]{24}$"},
    "subjects": {
      "type": "array", "minItems": 5, "maxItems": 5, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "subject_run_id", "root_manifest_sha256", "evidence_manifest_sha256", "subject_archive_tree_sha256", "production_build_identity_sha256", "fault_build_identity_sha256", "runtime_image_hashes"],
        "properties": {
          "case_id": {"enum": ["callback_loss", "callback_status", "producer_identity_mismatch", "stage_loss", "stage_status"]},
          "subject_run_id": {"type": "string", "minLength": 1},
          "root_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "subject_archive_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "production_build_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fault_build_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "runtime_image_hashes": {"type": "object", "additionalProperties": false, "required": ["sut", "extension"], "properties": {"sut": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "extension": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
        }
      }
    }
  },
  "additionalProperties": false
}
