{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ibmw.example/schemas/ohos-capture-manifest.schema.v2.json",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "nonce", "request_challenge", "run_id", "capability_id", "path_id", "topology_generation", "topology_sha256", "trace_mode", "exact_required", "boot_id", "agent_executable_sha256", "request_sha256", "child_pid", "child_start_time_ticks", "wait_status", "graceful", "no_escalation", "descendant_policy", "descendant_detected", "semantic_validation", "source_files", "archive_tree_sha256", "snapshot_valid", "reasons", "capture_role", "campaign_id", "fault", "workload_id", "registration_contract", "runtime_images", "completion_images", "ready_observed", "ready_attested", "release_granted", "completion_observed", "completion_attested", "evidence_released", "completion_eof_observed", "ready_images_sha256", "completion_images_sha256", "device_completion_sha256", "device_runtime_attestation_sha256"],
  "properties": {
    "protocol": {"const": "mw_perf.ohos_remote_capture.v2"}, "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}, "request_challenge": {"$ref": "#/$defs/hash"},
    "run_id": {"type": "string", "minLength": 1}, "capability_id": {"const": "dds.ordinary.nonplain.single_driver.sync_callback"}, "path_id": {"type": "string", "minLength": 1},
    "topology_generation": {"type": "string", "minLength": 1}, "topology_sha256": {"$ref": "#/$defs/hash"}, "trace_mode": {"const": "full"}, "exact_required": {"const": true},
    "boot_id": {"type": "string", "minLength": 1}, "agent_executable_sha256": {"$ref": "#/$defs/hash"}, "request_sha256": {"$ref": "#/$defs/hash"},
    "child_pid": {"type": "integer", "minimum": 2}, "child_start_time_ticks": {"type": "integer", "minimum": 1}, "wait_status": {"const": 0},
    "graceful": {"const": true}, "no_escalation": {"const": true}, "descendant_policy": {"const": "forbid"}, "descendant_detected": {"const": false}, "semantic_validation": {"const": false},
    "source_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "size", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "archive_tree_sha256": {"$ref": "#/$defs/hash"}, "snapshot_valid": {"const": true}, "reasons": {"type": "array", "maxItems": 0},
    "capture_role": {"const": "exact_anchor"}, "campaign_id": {"type": "string", "minLength": 1}, "fault": {"const": "none"}, "workload_id": {"const": "dds.ordinary.nonplain.single_driver.sync_callback"},
    "registration_contract": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"const": "mw_perf.p0a_contract.v8"}, "sha256": {"const": "c8f76997156ecd6e608f0d5d4a0d756d3e5748e8b21c67895936ee004a614575"}}},
    "runtime_images": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/image"}},
    "completion_images": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/live"}},
    "ready_observed": {"const": true}, "ready_attested": {"const": true}, "release_granted": {"const": true}, "completion_observed": {"const": true}, "completion_attested": {"const": true}, "evidence_released": {"const": true}, "completion_eof_observed": {"const": true},
    "ready_images_sha256": {"$ref": "#/$defs/hash"}, "completion_images_sha256": {"$ref": "#/$defs/hash"},
    "device_completion_sha256": {"$ref": "#/$defs/hash"}, "device_runtime_attestation_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "image": {"type": "object", "additionalProperties": false, "required": ["role", "name", "source", "path", "sha256"], "properties": {"role": {"enum": ["sut", "extension"]}, "name": {"type": "string", "minLength": 1}, "source": {"enum": ["exe", "maps"]}, "path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/hash"}}}, "live": {"type": "object", "additionalProperties": false, "required": ["role", "name", "source", "expected_path", "expected_sha256", "observed_sha256", "observed_device_major", "observed_device_minor", "observed_inode", "visible", "matched"], "properties": {"role": {"enum": ["sut", "extension"]}, "name": {"type": "string", "minLength": 1}, "source": {"enum": ["exe", "maps"]}, "expected_path": {"type": "string", "pattern": "^/"}, "expected_sha256": {"$ref": "#/$defs/hash"}, "observed_sha256": {"$ref": "#/$defs/hash"}, "observed_device_major": {"type": "integer", "minimum": 0}, "observed_device_minor": {"type": "integer", "minimum": 0}, "observed_inode": {"type": "integer", "minimum": 1}, "visible": {"const": true}, "matched": {"const": true}}}}
}
