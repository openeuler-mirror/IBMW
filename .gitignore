# ---- Source allowlist exceptions --------------------------------------------
# Source trees that collide with broad ignore rules above
# (`core` matches src/core/ runtime engine; `core.*` matches src/api/cpp/core.h
#  public header; `install/` matches CLI jinja templates dir).
!src/core/
!src/core/**
!src/api/cpp/core.h
!tools/mw_perf_collect/core.py
!src/tools/ibmw_cli/ibmw_cli/templates/install/
!src/tools/ibmw_cli/ibmw_cli/templates/install/**
# The log CLI source directory is not a colcon log output directory.
!src/extensions/cli/log/
!src/extensions/cli/log/**
