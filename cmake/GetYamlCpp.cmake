include(FetchContent)

message(STATUS "get yaml-cpp ...")

set(yaml-cpp_DOWNLOAD_URL
    "https://github.com/jbeder/yaml-cpp/archive/0.8.0.tar.gz"
    CACHE STRING "")
set(yaml-cpp_DOWNLOAD_SHA256
    "fbe74bbdcee21d656715688706da3c8becfd946d92cd44705cc6098bb23b3a16"
    CACHE STRING "SHA256 of yaml-cpp_DOWNLOAD_URL (update both together)")

if(yaml-cpp_LOCAL_SOURCE)
  FetchContent_Declare(
    yaml-cpp
    SOURCE_DIR ${yaml-cpp_LOCAL_SOURCE}
    OVERRIDE_FIND_PACKAGE)
else()
  FetchContent_Declare(
    yaml-cpp
    URL ${yaml-cpp_DOWNLOAD_URL}
    URL_HASH SHA256=${yaml-cpp_DOWNLOAD_SHA256}
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    OVERRIDE_FIND_PACKAGE)
endif()

# Wrap it in a function to restrict the scope of the variables
function(get_yaml_cpp)
  FetchContent_GetProperties(yaml-cpp)
  if(NOT yaml-cpp_POPULATED)
    set(BUILD_TESTING OFF)

    set(YAML_CPP_BUILD_TESTS OFF)

    set(YAML_CPP_BUILD_TOOLS OFF)

    set(YAML_CPP_INSTALL ${IBMW_INSTALL})

    set(YAML_CPP_FORMAT_SOURCE OFF)

    set(YAML_CPP_BUILD_CONTRIB OFF)

    FetchContent_MakeAvailable(yaml-cpp)

    # Build-tree export: mirror GetAsio.cmake / GetBackward.cmake. Upstream
    # yaml-cpp owns its install(EXPORT yaml-cpp-targets) when YAML_CPP_INSTALL=ON,
    # but does NOT call export() — so a build-tree find_package(yaml-cpp) cannot
    # resolve targets. We add export() here so the ibmw build-tree package
    # config can find_dependency(yaml-cpp) without an install step.
    # See docs/contributing/testing.md.
    if(IBMW_INSTALL AND TARGET yaml-cpp)
      export(
        EXPORT yaml-cpp-targets
        NAMESPACE yaml-cpp::
        FILE "${CMAKE_BINARY_DIR}/build-tree-config/lib/cmake/yaml-cpp/yaml-cpp-targets.cmake")
      # Build-tree wrapper config: do NOT reuse upstream yaml-cpp-config.cmake
      # because it uses set_and_check(YAML_CPP_INCLUDE_DIR ${PACKAGE_PREFIX_DIR}/include)
      # which only resolves correctly under the install layout. In the build-tree
      # layout, include/ does not exist next to lib/cmake/yaml-cpp/. Instead we
      # hand-write a minimal config that just pulls in the targets file —
      # IMPORTED targets already carry absolute INTERFACE_INCLUDE_DIRECTORIES /
      # IMPORTED_LOCATION pointing to the source tree and build dir respectively.
      # See docs/contributing/testing.md.
      file(WRITE
        "${CMAKE_BINARY_DIR}/build-tree-config/lib/cmake/yaml-cpp/yaml-cpp-config.cmake"
        "# Build-tree config wrapper for yaml-cpp (auto-generated by GetYamlCpp.cmake).\n"
        "# Upstream yaml-cpp-config.cmake assumes install layout (PACKAGE_PREFIX_DIR/include);\n"
        "# this wrapper just imports targets which carry absolute paths.\n"
        "include(\"\${CMAKE_CURRENT_LIST_DIR}/yaml-cpp-targets.cmake\")\n"
        "set(YAML_CPP_LIBRARIES yaml-cpp::yaml-cpp)\n")
      configure_file(
        "${yaml-cpp_BINARY_DIR}/yaml-cpp-config-version.cmake"
        "${CMAKE_BINARY_DIR}/build-tree-config/lib/cmake/yaml-cpp/yaml-cpp-config-version.cmake"
        COPYONLY)
    endif()
  endif()
endfunction()

get_yaml_cpp()

