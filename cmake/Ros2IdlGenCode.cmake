# Ros2IdlGenCode.cmake - Generate C++ RPC code from ROS2 IDL (msg/srv) files
#
# This module provides functions to integrate ROS2 message and service types
# into the IBMW framework. It wraps rosidl-generated types with IBMW type support.
#
# Usage:
#   add_ros2_idl_gencode_target(
#     TARGET_NAME <target>
#     PACKAGE_NAME <ros2_package_name>
#     MSG_FILES <file1.msg> [file2.msg ...]
#     SRV_FILES <file1.srv> [file2.srv ...]
#     GENCODE_PATH <output_directory>
#     [DEPENDENCIES <dep1> [dep2 ...]]
#   )

# Generate IBMW type support wrappers for ROS2 message types
function(add_ros2_idl_gencode_target)
  cmake_parse_arguments(ARG "" "TARGET_NAME;PACKAGE_NAME;GENCODE_PATH" "MSG_FILES;SRV_FILES;DEPENDENCIES" ${ARGN})

  if(NOT IBMW_BUILD_WITH_ROS2)
    message(STATUS "ROS2 support disabled, skipping ROS2 IDL target: ${ARG_TARGET_NAME}")
    return()
  endif()

  if(NOT EXISTS ${ARG_GENCODE_PATH})
    file(MAKE_DIRECTORY ${ARG_GENCODE_PATH})
  endif()

  # ROS2 message types are generated by the ROS2 build system (colcon/ament)
  # This function creates a wrapper target that provides IBMW type support
  # for the ROS2-generated types.

  # For now, create an interface library that depends on the ROS2 package
  add_library(${ARG_TARGET_NAME} INTERFACE)

  target_include_directories(${ARG_TARGET_NAME}
    INTERFACE
      $<BUILD_INTERFACE:${ARG_GENCODE_PATH}>
      $<INSTALL_INTERFACE:include/${ARG_TARGET_NAME}>
  )

  # Find and link the ROS2 package
  find_package(${ARG_PACKAGE_NAME} REQUIRED)
  target_link_libraries(${ARG_TARGET_NAME} INTERFACE ${${ARG_PACKAGE_NAME}_TARGETS})

  # Link dependencies
  foreach(DEP ${ARG_DEPENDENCIES})
    target_link_libraries(${ARG_TARGET_NAME} INTERFACE ${DEP})
  endforeach()

endfunction()
