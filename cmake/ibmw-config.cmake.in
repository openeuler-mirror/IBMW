#
# IBMW CMake Config File
#
# This file is loaded by find_package(ibmw). It locates all transitive
# dependencies before including the generated ibmw-targets.cmake file.
#
# Exported targets:
#   ibmw::base              - Base utilities (header-only, depends on fmt)
#   ibmw::api::c            - C ABI API (header-only)
#   ibmw::api::cpp          - C++ API (header-only, depends on unifex/stdexec/selfdev coro;
#                             selfdev coro ships the shared library libibmw_selfdev_coro)
#   ibmw::api::pkg          - Pkg-mode entry point (header-only)
#   ibmw::api::type_support - Type support plugin API (header-only)
#   ibmw::api::dds_type_support  - DDS TypeSupport package adapter
#   ibmw::api::ros2_type_support - ROS2 TypeSupport package adapter
#   ibmw::core::extension_api - Extension development API (header-only)
#   ibmw::core::engine      - Engine static library (App-mode, links asio/yaml-cpp/concurrent containers/crash handler)
#   ibmw::core::main        - The ibmw executable (Pkg-mode runner)
#
# Conditionally exported (when built with DDS/ROS2):
#   ibmw::extensions::dds_types            - DDS transport integration
#   ibmw::extensions::ros2_types           - ROS2 transport integration
#   ibmw::schema::*_idl_gencode            - IDL-generated schema code
#   ibmw::schema::*_rpc_gencode            - RPC-generated schema code

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Snapshot the package prefix immediately. Some transitive dependency config
# files also use PACKAGE_PREFIX_DIR and may overwrite it in the caller scope.
set(_IBMW_PACKAGE_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")

# --------------------------------------------------------------------------
# Include convenience helpers early.
# --------------------------------------------------------------------------
# Resolve helper/tool paths before find_dependency() calls can mutate
# PACKAGE_PREFIX_DIR. External projects should be able to use helper macros
# after find_package(ibmw) without manually including IBMW cmake files.
set_and_check(IBMW_HELPERS_DIR "@PACKAGE_IBMW_HELPERS_DIR@")
set_and_check(IBMW_DDS_IDL_RPC_GEN_TOOL_PATH "@PACKAGE_IBMW_DDS_IDL_RPC_GEN_TOOL_PATH@")

if(EXISTS "${IBMW_HELPERS_DIR}")
  list(APPEND CMAKE_MODULE_PATH "${IBMW_HELPERS_DIR}")
  list(REMOVE_DUPLICATES CMAKE_MODULE_PATH)
endif()

include("${IBMW_HELPERS_DIR}/IbmwHelpers.cmake" OPTIONAL)

if(EXISTS "${IBMW_DDS_IDL_RPC_GEN_TOOL_PATH}/dds_idl_gen_rpc.py")
  set_property(GLOBAL PROPERTY DDS_IDL_RPC_GEN_CODE_TOOL_PATH_PROPERTY
    "${IBMW_DDS_IDL_RPC_GEN_TOOL_PATH}")
endif()

# --------------------------------------------------------------------------
# Core dependencies (always required)
# --------------------------------------------------------------------------

# Public TypeSupport headers expose JSON and its compile-time configuration.
find_dependency(nlohmann_json CONFIG)

# fmt (header-only) — required by ibmw::base
find_dependency(fmt)

# Executor implementation — required by ibmw::api::cpp
if(@IBMW_EXECUTOR_USE_STDEXEC@)
  find_dependency(stdexec)
elseif(@IBMW_EXECUTOR_USE_SELFDEV_CORO@)
  # ibmw::selfdev::coro is exported with ibmw itself: headers plus the shared
  # library libibmw_selfdev_coro (installed to lib/; it holds the one
  # per-thread slot of Task's synchronous-completion handoff, so it is never
  # static). It links Threads::Threads, which API-only installs do not look
  # up below.
  find_dependency(Threads)
else()
  # unifex requires std::coroutines target (from FindCoroutines.cmake, not
  # installed by unifex). Create it if missing — on C++20/GCC11+ coroutine
  # support is built-in, so no special flags are needed.
  if(NOT TARGET std::coroutines)
    add_library(std::coroutines INTERFACE IMPORTED)
  endif()
  find_dependency(unifex)
endif()

# --------------------------------------------------------------------------
# Runtime dependencies (required by ibmw::core::engine)
# --------------------------------------------------------------------------
if(@IBMW_BUILD_RUNTIME@)
  find_package(Threads QUIET)

  # asio — custom INTERFACE library installed alongside ibmw
  find_dependency(asio)

  # yaml-cpp
  find_dependency(yaml-cpp)

  # TBB — not needed with the selfdev concurrent containers
  if(NOT @IBMW_SELFDEV_CONCURRENT@)
    find_dependency(TBB)
  endif()

  # Backward::Backward — custom INTERFACE library installed alongside ibmw.
  # Not needed with the selfdev crash handler (exported in ibmw-targets).
  if(NOT @IBMW_SELFDEV_CRASH_HANDLER@)
    find_dependency(backward)
  endif()
endif()

# --------------------------------------------------------------------------
# DDS dependencies (FastCDR / FastDDS)
# --------------------------------------------------------------------------
# FastCDR and FastDDS are always needed when the project was built with
# DDS/protocol support, as they underpin the type system and schema targets.
# The iceoryx and shm extensions export dds_types as well.
if(@IBMW_BUILD_PROTOCOLS@ OR @IBMW_BUILD_DDS_EXTENSION@ OR
   @IBMW_BUILD_ROS2_TYPES@ OR @IBMW_BUILD_ICEORYX_EXTENSION@ OR
   @IBMW_BUILD_SHM_EXTENSION@)
  set(_IBMW_BUILT_DDS_PROVIDER "@IBMW_DDS_PROVIDER@")
  if(DEFINED IBMW_DDS_PROVIDER AND
     NOT "${IBMW_DDS_PROVIDER}" STREQUAL "${_IBMW_BUILT_DDS_PROVIDER}")
    message(FATAL_ERROR
      "ibmw was built with DDS provider ${_IBMW_BUILT_DDS_PROVIDER}, but the consumer selected ${IBMW_DDS_PROVIDER}")
  endif()
  set(IBMW_DDS_PROVIDER "${_IBMW_BUILT_DDS_PROVIDER}")

  function(_ibmw_config_require_package_prefix package prefix)
    file(REAL_PATH "${prefix}" _ibmw_prefix_real)
    foreach(_ibmw_var IN ITEMS ${package}_DIR ${package}_CONFIG)
      if(DEFINED ${_ibmw_var} AND NOT "${${_ibmw_var}}" STREQUAL "")
        file(REAL_PATH "${${_ibmw_var}}" _ibmw_path_real)
        string(FIND "${_ibmw_path_real}/" "${_ibmw_prefix_real}/" _ibmw_prefix_pos)
        if(NOT _ibmw_prefix_pos EQUAL 0)
          message(FATAL_ERROR "ibmw DDS dependency ${package} resolved outside selected prefix '${prefix}': ${${_ibmw_var}}")
        endif()
      endif()
    endforeach()
  endfunction()

  function(_ibmw_config_require_version package actual expected)
    if(NOT actual OR NOT actual VERSION_EQUAL expected)
      message(FATAL_ERROR "ibmw requires exact ${package} ${expected}, but selected '${actual}'")
    endif()
  endfunction()

  function(_ibmw_config_require_metadata_version package version_file expected)
    if(NOT EXISTS "${version_file}")
      message(FATAL_ERROR "ibmw requires ${package} version metadata under the selected SDK prefix: ${version_file}")
    endif()
    file(READ "${version_file}" _version_metadata)
    if(NOT _version_metadata MATCHES "set\\(PACKAGE_VERSION[ \t]+\"([^\"]+)\"\\)")
      message(FATAL_ERROR "ibmw could not read ${package} version metadata: ${version_file}")
    endif()
    _ibmw_config_require_version("${package}" "${CMAKE_MATCH_1}" "${expected}")
  endfunction()

  function(_ibmw_config_validate_target target prefix)
    get_target_property(_imported ${target} IMPORTED)
    if(NOT _imported)
      message(FATAL_ERROR "${target} must be an imported target from the selected SDK prefix")
    endif()
    get_target_property(_configs ${target} IMPORTED_CONFIGURATIONS)
    set(_props IMPORTED_LOCATION)
    foreach(_config IN LISTS _configs)
      list(APPEND _props "IMPORTED_LOCATION_${_config}")
    endforeach()
    set(_has_location FALSE)
    foreach(_prop IN LISTS _props)
      get_target_property(_value ${target} ${_prop})
      if(_value AND NOT _value MATCHES "-NOTFOUND$")
        if(NOT EXISTS "${_value}")
          message(FATAL_ERROR "${target} ${_prop} does not exist: ${_value}")
        endif()
        set(_has_location TRUE)
        file(REAL_PATH "${_value}" _real)
        file(REAL_PATH "${prefix}" _prefix)
        string(FIND "${_real}/" "${_prefix}/" _pos)
        if(NOT _pos EQUAL 0)
          message(FATAL_ERROR "${target} ${_prop} escapes selected SDK prefix: ${_value}")
        endif()
        if(CMAKE_CROSSCOMPILING AND CMAKE_READELF AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
          execute_process(COMMAND "${CMAKE_READELF}" -h "${_value}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _elf)
          if(NOT _rc EQUAL 0 OR NOT _elf MATCHES "(^|\n)[ \t]*Machine:[ \t]*AArch64[ \t]*(\r?\n|$)")
            message(FATAL_ERROR "${target} library is not exact AArch64 ELF: ${_value}")
          endif()
        endif()
      endif()
    endforeach()
    if(NOT _has_location)
      message(FATAL_ERROR "${target} has no usable imported library location")
    endif()
    get_target_property(_includes ${target} INTERFACE_INCLUDE_DIRECTORIES)
    foreach(_include IN LISTS _includes)
      if(IS_ABSOLUTE "${_include}")
        file(REAL_PATH "${_include}" _real)
        file(REAL_PATH "${prefix}" _prefix)
        string(FIND "${_real}/" "${_prefix}/" _pos)
        if(NOT _pos EQUAL 0)
          message(FATAL_ERROR "${target} absolute include escapes selected SDK prefix: ${_include}")
        endif()
      endif()
    endforeach()
    get_target_property(_links ${target} INTERFACE_LINK_LIBRARIES)
    foreach(_link IN LISTS _links)
      if(IS_ABSOLUTE "${_link}")
        file(REAL_PATH "${_link}" _real)
        file(REAL_PATH "${prefix}" _prefix)
        string(FIND "${_real}/" "${_prefix}/" _pos)
        if(NOT _pos EQUAL 0)
          message(FATAL_ERROR "${target} absolute link escapes selected SDK prefix: ${_link}")
        endif()
      endif()
    endforeach()
  endfunction()

  if(_IBMW_BUILT_DDS_PROVIDER STREQUAL "ROS2_MINIMAL_SDK")
    if(NOT IBMW_ROS2_MINIMAL_SDK_PREFIX)
      if(EXISTS "${_IBMW_PACKAGE_PREFIX_DIR}/lib/cmake/fastcdr" AND
         EXISTS "${_IBMW_PACKAGE_PREFIX_DIR}/share/fastrtps/cmake")
        set(IBMW_ROS2_MINIMAL_SDK_PREFIX "${_IBMW_PACKAGE_PREFIX_DIR}")
      else()
        message(FATAL_ERROR "ibmw was built with ROS2_MINIMAL_SDK. Set IBMW_ROS2_MINIMAL_SDK_PREFIX to the matching consumer SDK; the build-time SDK path is intentionally not embedded.")
      endif()
    endif()
    if(NOT IS_DIRECTORY "${IBMW_ROS2_MINIMAL_SDK_PREFIX}")
      message(FATAL_ERROR "IBMW_ROS2_MINIMAL_SDK_PREFIX must name an existing SDK prefix")
    endif()
    set(_ibmw_existing_dds_targets 0)
    foreach(_target IN ITEMS fastcdr fastrtps foonathan_memory)
      if(TARGET ${_target})
        math(EXPR _ibmw_existing_dds_targets "${_ibmw_existing_dds_targets} + 1")
      endif()
    endforeach()
    if(_ibmw_existing_dds_targets EQUAL 0)
      unset(fastcdr_DIR CACHE)
      unset(fastrtps_DIR CACHE)
      find_package(fastcdr 1.0.29 EXACT REQUIRED CONFIG PATHS "${IBMW_ROS2_MINIMAL_SDK_PREFIX}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
      unset(foonathan_memory_DIR CACHE)
      find_package(foonathan_memory 0.7.1 EXACT REQUIRED CONFIG
        PATHS "${IBMW_ROS2_MINIMAL_SDK_PREFIX}/lib/foonathan_memory/cmake"
        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
      _ibmw_config_require_package_prefix(foonathan_memory "${IBMW_ROS2_MINIMAL_SDK_PREFIX}")
      find_package(fastrtps 2.6.12 EXACT REQUIRED CONFIG PATHS "${IBMW_ROS2_MINIMAL_SDK_PREFIX}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
      _ibmw_config_require_version("Fast CDR" "${fastcdr_VERSION}" "1.0.29")
      _ibmw_config_require_version("foonathan_memory" "${foonathan_memory_VERSION}" "0.7.1")
      _ibmw_config_require_version("Fast DDS/fastrtps" "${fastrtps_VERSION}" "2.6.12")
      _ibmw_config_require_package_prefix(fastcdr "${IBMW_ROS2_MINIMAL_SDK_PREFIX}")
      _ibmw_config_require_package_prefix(fastrtps "${IBMW_ROS2_MINIMAL_SDK_PREFIX}")
    elseif(NOT _ibmw_existing_dds_targets EQUAL 3)
      message(FATAL_ERROR "A partial set of Fast DDS targets already exists; load all dependencies from the selected ROS2 minimal SDK before finding ibmw")
    else()
      _ibmw_config_require_metadata_version("Fast CDR"
        "${IBMW_ROS2_MINIMAL_SDK_PREFIX}/lib/cmake/fastcdr/fastcdr-config-version.cmake" "1.0.29")
      _ibmw_config_require_metadata_version("foonathan_memory"
        "${IBMW_ROS2_MINIMAL_SDK_PREFIX}/lib/foonathan_memory/cmake/foonathan_memory-config-version.cmake" "0.7.1")
      _ibmw_config_require_metadata_version("Fast DDS/fastrtps"
        "${IBMW_ROS2_MINIMAL_SDK_PREFIX}/share/fastrtps/cmake/fastrtps-config-version.cmake" "2.6.12")
    endif()
    unset(_ibmw_existing_dds_targets)
    foreach(_target IN ITEMS fastcdr fastrtps foonathan_memory)
      _ibmw_config_validate_target(${_target} "${IBMW_ROS2_MINIMAL_SDK_PREFIX}")
    endforeach()
  elseif(_IBMW_BUILT_DDS_PROVIDER STREQUAL "SOURCE_FASTDDS2")
    if(NOT IBMW_THIRD_PARTY_SOURCE_PREFIX)
      if(EXISTS "${_IBMW_PACKAGE_PREFIX_DIR}/lib/cmake/fastcdr" AND
         EXISTS "${_IBMW_PACKAGE_PREFIX_DIR}/share/fastrtps/cmake")
        set(IBMW_THIRD_PARTY_SOURCE_PREFIX "${_IBMW_PACKAGE_PREFIX_DIR}")
      else()
        message(FATAL_ERROR "ibmw was built with SOURCE_FASTDDS2. Set IBMW_THIRD_PARTY_SOURCE_PREFIX to the matching Fast DDS 2 SDK.")
      endif()
    endif()
    foreach(_target IN ITEMS fastcdr fastrtps foonathan_memory)
      if(TARGET ${_target})
        _ibmw_config_validate_target(${_target} "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
      endif()
    endforeach()
    unset(fastcdr_DIR CACHE)
    unset(fastrtps_DIR CACHE)
    unset(foonathan_memory_DIR CACHE)
    find_package(foonathan_memory 0.7.1 EXACT REQUIRED CONFIG
      PATHS "${IBMW_THIRD_PARTY_SOURCE_PREFIX}/lib/foonathan_memory/cmake"
      NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    find_package(fastcdr 1.0.29 EXACT REQUIRED CONFIG PATHS "${IBMW_THIRD_PARTY_SOURCE_PREFIX}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    find_package(fastrtps 2.6.12 EXACT REQUIRED CONFIG PATHS "${IBMW_THIRD_PARTY_SOURCE_PREFIX}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    _ibmw_config_require_version("Fast CDR" "${fastcdr_VERSION}" "1.0.29")
    _ibmw_config_require_version("Fast DDS/fastrtps" "${fastrtps_VERSION}" "2.6.12")
    _ibmw_config_require_version("foonathan_memory" "${foonathan_memory_VERSION}" "0.7.1")
    _ibmw_config_require_package_prefix(fastcdr "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    _ibmw_config_require_package_prefix(fastrtps "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    _ibmw_config_require_package_prefix(foonathan_memory "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    foreach(_target IN ITEMS fastcdr fastrtps foonathan_memory)
      _ibmw_config_validate_target(${_target} "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    endforeach()
    set(IBMW_FASTCDR_PROVIDER_TARGET fastcdr)
    set(IBMW_FASTDDS_PROVIDER_TARGET fastrtps)
  elseif(_IBMW_BUILT_DDS_PROVIDER STREQUAL "SOURCE_FASTDDS3")
    if(NOT IBMW_THIRD_PARTY_SOURCE_PREFIX)
      if(EXISTS "${_IBMW_PACKAGE_PREFIX_DIR}/lib/cmake/fastcdr" AND
         EXISTS "${_IBMW_PACKAGE_PREFIX_DIR}/share/fastdds/cmake")
        set(IBMW_THIRD_PARTY_SOURCE_PREFIX "${_IBMW_PACKAGE_PREFIX_DIR}")
      else()
        message(FATAL_ERROR "ibmw was built with SOURCE_FASTDDS3. Set IBMW_THIRD_PARTY_SOURCE_PREFIX to the matching Fast DDS 3 SDK.")
      endif()
    endif()
    foreach(_target IN ITEMS fastcdr fastdds foonathan_memory)
      if(TARGET ${_target})
        _ibmw_config_validate_target(${_target} "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
      endif()
    endforeach()
    unset(fastcdr_DIR CACHE)
    unset(fastdds_DIR CACHE)
    unset(foonathan_memory_DIR CACHE)
    find_package(foonathan_memory 0.7.3 EXACT REQUIRED CONFIG
      PATHS "${IBMW_THIRD_PARTY_SOURCE_PREFIX}/lib/foonathan_memory/cmake"
      NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    find_package(fastcdr 2.3.0 EXACT REQUIRED CONFIG PATHS "${IBMW_THIRD_PARTY_SOURCE_PREFIX}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    find_package(fastdds 3.2.2 EXACT REQUIRED CONFIG PATHS "${IBMW_THIRD_PARTY_SOURCE_PREFIX}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
    _ibmw_config_require_version("Fast CDR" "${fastcdr_VERSION}" "2.3.0")
    _ibmw_config_require_version("Fast DDS" "${fastdds_VERSION}" "3.2.2")
    _ibmw_config_require_version("foonathan_memory" "${foonathan_memory_VERSION}" "0.7.3")
    _ibmw_config_require_package_prefix(fastcdr "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    _ibmw_config_require_package_prefix(fastdds "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    _ibmw_config_require_package_prefix(foonathan_memory "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    foreach(_target IN ITEMS fastcdr fastdds foonathan_memory)
      _ibmw_config_validate_target(${_target} "${IBMW_THIRD_PARTY_SOURCE_PREFIX}")
    endforeach()
    set(IBMW_FASTCDR_PROVIDER_TARGET fastcdr)
    set(IBMW_FASTDDS_PROVIDER_TARGET fastdds)
  else()
    if("@fastcdr_VERSION@" STREQUAL "")
      find_dependency(fastcdr CONFIG)
    else()
      find_dependency(fastcdr @fastcdr_VERSION@ EXACT CONFIG)
    endif()
    if("@fastdds_VERSION@" STREQUAL "")
      find_package(fastdds CONFIG QUIET)
      if(NOT fastdds_FOUND)
        find_dependency(fastrtps CONFIG)
      endif()
    elseif("@fastdds_VERSION@" VERSION_GREATER_EQUAL "3")
      find_dependency(fastdds @fastdds_VERSION@ EXACT CONFIG)
    else()
      find_dependency(fastrtps @fastdds_VERSION@ EXACT CONFIG)
    endif()
  endif()

  if(TARGET fastrtps AND NOT TARGET fastdds)
    add_library(fastdds INTERFACE IMPORTED)
    set_property(TARGET fastdds PROPERTY INTERFACE_LINK_LIBRARIES fastrtps)
  endif()

  if("@IBMW_TARGET_ROS2_TIER@" STREQUAL "rosidl")
    # Route-B rosidl builds export canonical names for their explicit target-
    # prefix providers. Recreate those names downstream using the packages
    # resolved above, without affecting native providers or embedding paths.
    if(NOT TARGET ibmw_target_fastcdr)
      add_library(ibmw_target_fastcdr INTERFACE IMPORTED)
      set_property(TARGET ibmw_target_fastcdr PROPERTY
        INTERFACE_LINK_LIBRARIES fastcdr)
    endif()
    if(NOT TARGET ibmw_target_fastrtps)
      add_library(ibmw_target_fastrtps INTERFACE IMPORTED)
      if(_IBMW_BUILT_DDS_PROVIDER STREQUAL "SOURCE_FASTDDS3")
        set_property(TARGET ibmw_target_fastrtps PROPERTY INTERFACE_LINK_LIBRARIES fastdds)
      else()
        set_property(TARGET ibmw_target_fastrtps PROPERTY INTERFACE_LINK_LIBRARIES fastrtps)
      endif()
    endif()
  endif()
endif()

# --------------------------------------------------------------------------
# ROS2 type support dependencies (rosidl build-time only, no rcl runtime)
# --------------------------------------------------------------------------
if(@IBMW_BUILD_ROS2_TYPES@)
  find_dependency(rosidl_typesupport_introspection_cpp)
  find_dependency(std_msgs)
  find_package(geometry_msgs QUIET)
  find_package(sensor_msgs QUIET)
endif()

# --------------------------------------------------------------------------
# ROS2 rcl dependencies (conditional — full ROS2 runtime)
# --------------------------------------------------------------------------
if(@IBMW_BUILD_WITH_ROS2@)
  find_dependency(rclcpp)

  # example_ros2 / ros2_ext_proto — only needed if example schemas were built
  find_package(example_ros2 QUIET)
  find_package(ros2_ext_proto QUIET)
endif()

# --------------------------------------------------------------------------
# Include the generated targets file
# --------------------------------------------------------------------------
include("${CMAKE_CURRENT_LIST_DIR}/ibmw-targets.cmake")

check_required_components(ibmw)
