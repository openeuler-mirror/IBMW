// Joint state messages

#include "Header.idl"

module ibmw {
  module protocols {
    module sensor {

      struct JointState {
        string name;
        double position;
        double velocity;
        double effort;
      };

      struct JointStateArray {
        ibmw::protocols::common::Header header;
        sequence<JointState> joints;
      };

    };
  };
};
