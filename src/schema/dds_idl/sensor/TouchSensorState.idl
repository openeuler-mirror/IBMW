// Touch sensor state messages

#include "Header.idl"

module ibmw {
  module protocols {
    module sensor {

      struct TouchSensorState {
        sequence<long> pressure;
      };

      struct TouchSensorStateArray {
        ibmw::protocols::common::Header header;
        sequence<string> names;
        sequence<TouchSensorState> states;
      };

    };
  };
};
