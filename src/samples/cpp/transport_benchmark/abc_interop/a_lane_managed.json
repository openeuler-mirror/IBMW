{
  "schema_version": 1,
  "run": {"sample_seconds": 5, "stop_timeout_seconds": 5},
  "sut": {
    "mode": "managed",
    "command": ["/bin/sh", "src/samples/cpp/transport_benchmark/abc_interop/run_a_managed.sh"],
    "working_directory": ".",
    "env": {
      "IBMW_ABC_ROS2_ENDPOINT": "build-benchmark-smoke/ibmw_abc_ros2_endpoint",
      "IBMW_ABC_LATENCY_JSONL": "/tmp/ibmw_abc_a_lane_latency.jsonl",
      "LD_LIBRARY_PATH": "/opt/ros/humble/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"
    }
  },
  "adapters": {"ros2": {"latency_artifact": {"path": "/tmp/ibmw_abc_a_lane_latency.jsonl", "required": true}}}
}
