# Editor defaults matching the existing tree (HYG-044). They apply to lines
# you edit; the tree is not reformatted.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false

[*.bat]
end_of_line = unset

[*.{mcap,lz4,zst,db3}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
